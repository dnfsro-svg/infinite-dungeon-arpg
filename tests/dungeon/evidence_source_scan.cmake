# Shared source scanner for evidence guards. Non-code characters become spaces
# while line endings and source length remain unchanged, so brace offsets stay valid.
function(evidence_is_cpp_splice source index output)
    string(ASCII 10 newline)
    string(ASCII 13 carriage_return)
    string(ASCII 92 backslash)
    string(LENGTH "${source}" source_length)
    if(index GREATER_EQUAL source_length)
        set(${output} FALSE PARENT_SCOPE)
        return()
    endif()
    string(SUBSTRING "${source}" ${index} 1 character)
    if(NOT character STREQUAL "${backslash}")
        set(${output} FALSE PARENT_SCOPE)
        return()
    endif()
    math(EXPR next_index "${index} + 1")
    if(next_index GREATER_EQUAL source_length)
        set(${output} FALSE PARENT_SCOPE)
        return()
    endif()
    string(SUBSTRING "${source}" ${next_index} 1 next_character)
    if(next_character STREQUAL "${newline}")
        set(${output} TRUE PARENT_SCOPE)
        return()
    endif()
    math(EXPR after_next_index "${index} + 2")
    if(next_character STREQUAL "${carriage_return}"
            AND after_next_index LESS source_length)
        string(SUBSTRING "${source}" ${after_next_index} 1 after_next_character)
        if(after_next_character STREQUAL "${newline}")
            set(${output} TRUE PARENT_SCOPE)
            return()
        endif()
    endif()
    set(${output} FALSE PARENT_SCOPE)
endfunction()

function(evidence_cpp_logical_next_character source start output_character output_found)
    string(ASCII 10 newline)
    string(ASCII 13 carriage_return)
    string(LENGTH "${source}" source_length)
    set(probe ${start})
    while(probe LESS source_length)
        evidence_is_cpp_splice("${source}" ${probe} is_splice)
        if(is_splice)
            math(EXPR newline_index "${probe} + 1")
            string(SUBSTRING "${source}" ${newline_index} 1 splice_newline)
            if(splice_newline STREQUAL "${carriage_return}")
                math(EXPR probe "${probe} + 3")
            else()
                math(EXPR probe "${probe} + 2")
            endif()
        else()
            string(SUBSTRING "${source}" ${probe} 1 logical_character)
            set(${output_character} "${logical_character}" PARENT_SCOPE)
            set(${output_found} TRUE PARENT_SCOPE)
            return()
        endif()
    endwhile()
    set(${output_character} "" PARENT_SCOPE)
    set(${output_found} FALSE PARENT_SCOPE)
endfunction()

function(evidence_sanitize_cpp_for_scan source output)
    string(ASCII 10 newline)
    string(ASCII 13 carriage_return)
    string(ASCII 34 double_quote)
    string(ASCII 39 single_quote)
    string(ASCII 92 backslash)
    string(LENGTH "${source}" source_length)
    if(source_length EQUAL 0)
        set(${output} "" PARENT_SCOPE)
        return()
    endif()

    math(EXPR source_last "${source_length} - 1")
    set(sanitized "")
    set(scan_state code)
    set(escaped FALSE)
    foreach(character_index RANGE 0 ${source_last})
        string(SUBSTRING "${source}" ${character_index} 1 character)
        set(next_character "")
        set(next_found FALSE)
        if(character_index LESS source_last)
            math(EXPR next_character_index "${character_index} + 1")
            evidence_cpp_logical_next_character("${source}" ${next_character_index}
                next_character next_found)
        endif()

        if(scan_state STREQUAL "code")
            if(next_found AND character STREQUAL "/" AND next_character STREQUAL "/")
                set(scan_state line_comment)
                string(APPEND sanitized " ")
            elseif(next_found AND character STREQUAL "/" AND next_character STREQUAL "*")
                set(scan_state block_comment)
                string(APPEND sanitized " ")
            elseif(character STREQUAL "${double_quote}")
                set(scan_state string_literal)
                set(escaped FALSE)
                string(APPEND sanitized " ")
            elseif(character STREQUAL "${single_quote}")
                set(scan_state character_literal)
                set(escaped FALSE)
                string(APPEND sanitized " ")
            else()
                string(APPEND sanitized "${character}")
            endif()
        elseif(scan_state STREQUAL "line_comment")
            evidence_is_cpp_splice("${source}" ${character_index} is_splice)
            if(character STREQUAL "${backslash}" AND is_splice)
                set(scan_state line_comment_splice)
                string(APPEND sanitized " ")
            elseif(character STREQUAL "${newline}" OR character STREQUAL "${carriage_return}")
                set(scan_state code)
                string(APPEND sanitized "${character}")
            else()
                string(APPEND sanitized " ")
            endif()
        elseif(scan_state STREQUAL "line_comment_splice")
            if(character STREQUAL "${newline}")
                set(scan_state line_comment)
                string(APPEND sanitized "${character}")
            elseif(character STREQUAL "${carriage_return}")
                string(APPEND sanitized "${character}")
            else()
                message(FATAL_ERROR "Evidence scanner expected a line splice terminator")
            endif()
        elseif(scan_state STREQUAL "block_comment")
            if(character STREQUAL "*" AND next_found AND next_character STREQUAL "/")
                set(scan_state block_comment_close_pending)
            endif()
            if(character STREQUAL "${newline}" OR character STREQUAL "${carriage_return}")
                string(APPEND sanitized "${character}")
            else()
                string(APPEND sanitized " ")
            endif()
        elseif(scan_state STREQUAL "block_comment_close_pending")
            if(character STREQUAL "/")
                set(scan_state code)
            endif()
            if(character STREQUAL "${newline}" OR character STREQUAL "${carriage_return}")
                string(APPEND sanitized "${character}")
            else()
                string(APPEND sanitized " ")
            endif()
        elseif(scan_state STREQUAL "string_literal"
                OR scan_state STREQUAL "character_literal")
            evidence_is_cpp_splice("${source}" ${character_index} is_splice)
            if(character STREQUAL "${backslash}" AND is_splice)
                set(splice_return_state "${scan_state}")
                set(scan_state literal_splice)
            elseif(escaped)
                set(escaped FALSE)
            elseif(character STREQUAL "${backslash}")
                set(escaped TRUE)
            elseif((scan_state STREQUAL "string_literal" AND character STREQUAL "${double_quote}")
                    OR (scan_state STREQUAL "character_literal" AND character STREQUAL "${single_quote}"))
                set(scan_state code)
            endif()
            if(character STREQUAL "${newline}" OR character STREQUAL "${carriage_return}")
                string(APPEND sanitized "${character}")
            else()
                string(APPEND sanitized " ")
            endif()
        elseif(scan_state STREQUAL "literal_splice")
            if(character STREQUAL "${newline}")
                set(scan_state "${splice_return_state}")
                string(APPEND sanitized "${character}")
            elseif(character STREQUAL "${carriage_return}")
                string(APPEND sanitized "${character}")
            else()
                message(FATAL_ERROR "Evidence scanner expected a literal splice terminator")
            endif()
        endif()
    endforeach()
    set(${output} "${sanitized}" PARENT_SCOPE)
endfunction()

function(evidence_find_cpp_function_bounds source signature output_begin output_open output_end)
    evidence_sanitize_cpp_for_scan("${source}" sanitized_source)
    string(FIND "${sanitized_source}" "${signature}" function_begin)
    if(function_begin EQUAL -1)
        message(FATAL_ERROR "Evidence validation function is missing: ${signature}")
    endif()
    string(SUBSTRING "${sanitized_source}" ${function_begin} -1 function_tail)
    string(FIND "${function_tail}" "{" brace_relative)
    if(brace_relative EQUAL -1)
        message(FATAL_ERROR "Evidence validation function has no opening brace: ${signature}")
    endif()
    math(EXPR brace_open "${function_begin} + ${brace_relative}")
    string(LENGTH "${sanitized_source}" source_length)
    math(EXPR source_last "${source_length} - 1")
    set(brace_depth 0)
    set(function_end -1)
    foreach(character_index RANGE ${brace_open} ${source_last})
        string(SUBSTRING "${sanitized_source}" ${character_index} 1 character)
        if(character STREQUAL "{")
            math(EXPR brace_depth "${brace_depth} + 1")
        elseif(character STREQUAL "}")
            math(EXPR brace_depth "${brace_depth} - 1")
            if(brace_depth EQUAL 0)
                set(function_end ${character_index})
                break()
            endif()
        endif()
    endforeach()
    if(function_end EQUAL -1)
        message(FATAL_ERROR "Evidence validation function has unbalanced braces: ${signature}")
    endif()
    set(${output_begin} ${function_begin} PARENT_SCOPE)
    set(${output_open} ${brace_open} PARENT_SCOPE)
    set(${output_end} ${function_end} PARENT_SCOPE)
endfunction()

function(evidence_extract_cpp_function_block source signature output)
    evidence_find_cpp_function_bounds("${source}" "${signature}"
        function_begin function_open function_end)
    evidence_sanitize_cpp_for_scan("${source}" sanitized_source)
    math(EXPR function_length "${function_end} - ${function_begin} + 1")
    string(SUBSTRING "${sanitized_source}" ${function_begin} ${function_length}
        function_block)
    set(${output} "${function_block}" PARENT_SCOPE)
endfunction()

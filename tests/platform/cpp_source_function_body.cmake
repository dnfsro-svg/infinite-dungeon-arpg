cmake_minimum_required(VERSION 3.25)

function(_scan_cpp_source SOURCE FUNCTION_MARKER PRESERVED_OUTPUT CODE_OUTPUT)
    string(LENGTH "${SOURCE}" SOURCE_LENGTH)
    if(SOURCE_LENGTH EQUAL 0)
        if(FUNCTION_MARKER STREQUAL "")
            set(${PRESERVED_OUTPUT} "" PARENT_SCOPE)
            set(${CODE_OUTPUT} "" PARENT_SCOPE)
            return()
        endif()
        message(FATAL_ERROR
            "Unable to find C++ function marker: ${FUNCTION_MARKER}")
    endif()

    string(LENGTH "${FUNCTION_MARKER}" MARKER_LENGTH)
    if(FUNCTION_MARKER STREQUAL "")
        set(EXTRACT_FUNCTION FALSE)
        set(MARKER_FOUND TRUE)
        set(BODY_STARTED TRUE)
    else()
        set(EXTRACT_FUNCTION TRUE)
        set(MARKER_FOUND FALSE)
        set(BODY_STARTED FALSE)
    endif()

    set(STATE normal)
    set(ESCAPED FALSE)
    set(DEPTH 0)
    set(PRESERVED)
    set(CODE)
    set(RAW_DELIMITER)
    set(RAW_END_REMAINING 0)
    math(EXPR LAST_INDEX "${SOURCE_LENGTH} - 1")

    foreach(INDEX RANGE 0 ${LAST_INDEX})
        string(SUBSTRING "${SOURCE}" ${INDEX} 1 CHARACTER)
        math(EXPR NEXT_INDEX "${INDEX} + 1")
        if(NEXT_INDEX LESS SOURCE_LENGTH)
            string(SUBSTRING "${SOURCE}" ${NEXT_INDEX} 1 NEXT_CHARACTER)
        else()
            set(NEXT_CHARACTER "")
        endif()
        if(INDEX GREATER 0)
            math(EXPR PREVIOUS_INDEX "${INDEX} - 1")
            string(SUBSTRING "${SOURCE}" ${PREVIOUS_INDEX} 1
                PREVIOUS_CHARACTER)
        else()
            set(PREVIOUS_CHARACTER "")
        endif()
        set(DIGIT_SEPARATOR FALSE)
        if(CHARACTER STREQUAL "'")
            string(REGEX MATCH "^[0-9A-Fa-f]$" PREVIOUS_IS_DIGIT
                "${PREVIOUS_CHARACTER}")
            string(REGEX MATCH "^[0-9A-Fa-f]$" NEXT_IS_DIGIT
                "${NEXT_CHARACTER}")
            if(PREVIOUS_IS_DIGIT AND NEXT_IS_DIGIT)
                set(DIGIT_SEPARATOR TRUE)
            endif()
        endif()

        if(STATE STREQUAL line_comment)
            if(BODY_STARTED)
                if(CHARACTER STREQUAL "\r" OR CHARACTER STREQUAL "\n")
                    string(APPEND PRESERVED "${CHARACTER}")
                    string(APPEND CODE "${CHARACTER}")
                else()
                    string(APPEND PRESERVED " ")
                    string(APPEND CODE " ")
                endif()
            endif()
            if(CHARACTER STREQUAL "\n")
                set(STATE normal)
            endif()
            continue()
        endif()

        if(STATE STREQUAL block_comment)
            if(BODY_STARTED)
                string(APPEND PRESERVED " ")
                string(APPEND CODE " ")
            endif()
            if(CHARACTER STREQUAL "/" AND INDEX GREATER 0)
                if(PREVIOUS_CHARACTER STREQUAL "*")
                    set(STATE normal)
                endif()
            endif()
            continue()
        endif()

        if(STATE STREQUAL string OR STATE STREQUAL character)
            if(BODY_STARTED)
                string(APPEND PRESERVED "${CHARACTER}")
                string(APPEND CODE " ")
            endif()
            if(ESCAPED)
                set(ESCAPED FALSE)
            elseif(CHARACTER STREQUAL "\\")
                set(ESCAPED TRUE)
            elseif((STATE STREQUAL string AND CHARACTER STREQUAL "\"")
                    OR (STATE STREQUAL character AND CHARACTER STREQUAL "'"))
                set(STATE normal)
            endif()
            continue()
        endif()

        if(STATE STREQUAL raw_quote)
            if(BODY_STARTED)
                string(APPEND PRESERVED "${CHARACTER}")
                string(APPEND CODE " ")
            endif()
            if(NOT CHARACTER STREQUAL "\"")
                message(FATAL_ERROR "Malformed C++ raw string opener")
            endif()
            set(STATE raw_delimiter)
            continue()
        endif()

        if(STATE STREQUAL raw_delimiter)
            if(BODY_STARTED)
                string(APPEND PRESERVED "${CHARACTER}")
                string(APPEND CODE " ")
            endif()
            if(CHARACTER STREQUAL "(")
                set(RAW_TERMINATOR ")${RAW_DELIMITER}\"")
                set(STATE raw_body)
            else()
                string(APPEND RAW_DELIMITER "${CHARACTER}")
                string(LENGTH "${RAW_DELIMITER}" RAW_DELIMITER_LENGTH)
                if(RAW_DELIMITER_LENGTH GREATER 16
                        OR CHARACTER STREQUAL "\r"
                        OR CHARACTER STREQUAL "\n")
                    message(FATAL_ERROR "Malformed C++ raw string delimiter")
                endif()
            endif()
            continue()
        endif()

        if(STATE STREQUAL raw_body)
            if(BODY_STARTED)
                string(APPEND PRESERVED "${CHARACTER}")
                string(APPEND CODE " ")
            endif()
            if(CHARACTER STREQUAL ")")
                string(LENGTH "${RAW_TERMINATOR}" RAW_TERMINATOR_LENGTH)
                math(EXPR AVAILABLE "${SOURCE_LENGTH} - ${INDEX}")
                if(AVAILABLE GREATER_EQUAL RAW_TERMINATOR_LENGTH)
                    string(SUBSTRING "${SOURCE}" ${INDEX}
                        ${RAW_TERMINATOR_LENGTH} RAW_CANDIDATE)
                    if(RAW_CANDIDATE STREQUAL RAW_TERMINATOR)
                        math(EXPR RAW_END_REMAINING
                            "${RAW_TERMINATOR_LENGTH} - 1")
                        if(RAW_END_REMAINING EQUAL 0)
                            set(STATE normal)
                        else()
                            set(STATE raw_end)
                        endif()
                    endif()
                endif()
            endif()
            continue()
        endif()

        if(STATE STREQUAL raw_end)
            if(BODY_STARTED)
                string(APPEND PRESERVED "${CHARACTER}")
                string(APPEND CODE " ")
            endif()
            math(EXPR RAW_END_REMAINING "${RAW_END_REMAINING} - 1")
            if(RAW_END_REMAINING EQUAL 0)
                set(STATE normal)
            endif()
            continue()
        endif()

        if(NOT BODY_STARTED AND CHARACTER STREQUAL "/"
                AND NEXT_CHARACTER STREQUAL "/")
            set(STATE line_comment)
            continue()
        endif()
        if(NOT BODY_STARTED AND CHARACTER STREQUAL "/"
                AND NEXT_CHARACTER STREQUAL "*")
            set(STATE block_comment)
            continue()
        endif()
        if(NOT BODY_STARTED AND CHARACTER STREQUAL "R"
                AND NEXT_CHARACTER STREQUAL "\"")
            set(STATE raw_quote)
            set(RAW_DELIMITER)
            continue()
        endif()
        if(NOT BODY_STARTED AND CHARACTER STREQUAL "\"")
            set(STATE string)
            set(ESCAPED FALSE)
            continue()
        endif()
        if(NOT BODY_STARTED AND CHARACTER STREQUAL "'"
                AND NOT DIGIT_SEPARATOR)
            set(STATE character)
            set(ESCAPED FALSE)
            continue()
        endif()

        if(NOT MARKER_FOUND)
            math(EXPR AVAILABLE "${SOURCE_LENGTH} - ${INDEX}")
            if(AVAILABLE GREATER_EQUAL MARKER_LENGTH)
                string(SUBSTRING "${SOURCE}" ${INDEX} ${MARKER_LENGTH}
                    MARKER_CANDIDATE)
                if(MARKER_CANDIDATE STREQUAL FUNCTION_MARKER)
                    set(MARKER_FOUND TRUE)
                endif()
            endif()
        endif()

        if(MARKER_FOUND AND NOT BODY_STARTED)
            if(CHARACTER STREQUAL "{")
                set(BODY_STARTED TRUE)
                set(DEPTH 1)
            endif()
            continue()
        endif()

        if(CHARACTER STREQUAL "/" AND NEXT_CHARACTER STREQUAL "/")
            set(STATE line_comment)
            if(BODY_STARTED)
                string(APPEND PRESERVED " ")
                string(APPEND CODE " ")
            endif()
            continue()
        endif()
        if(CHARACTER STREQUAL "/" AND NEXT_CHARACTER STREQUAL "*")
            set(STATE block_comment)
            if(BODY_STARTED)
                string(APPEND PRESERVED " ")
                string(APPEND CODE " ")
            endif()
            continue()
        endif()
        if(CHARACTER STREQUAL "R" AND NEXT_CHARACTER STREQUAL "\"")
            set(STATE raw_quote)
            set(RAW_DELIMITER)
            if(BODY_STARTED)
                string(APPEND PRESERVED "${CHARACTER}")
                string(APPEND CODE " ")
            endif()
            continue()
        endif()
        if(CHARACTER STREQUAL "\"")
            set(STATE string)
            set(ESCAPED FALSE)
            if(BODY_STARTED)
                string(APPEND PRESERVED "${CHARACTER}")
                string(APPEND CODE " ")
            endif()
            continue()
        endif()
        if(CHARACTER STREQUAL "'" AND NOT DIGIT_SEPARATOR)
            set(STATE character)
            set(ESCAPED FALSE)
            if(BODY_STARTED)
                string(APPEND PRESERVED "${CHARACTER}")
                string(APPEND CODE " ")
            endif()
            continue()
        endif()

        if(EXTRACT_FUNCTION AND BODY_STARTED AND CHARACTER STREQUAL "{")
            math(EXPR DEPTH "${DEPTH} + 1")
        elseif(EXTRACT_FUNCTION AND BODY_STARTED AND CHARACTER STREQUAL "}")
            math(EXPR DEPTH "${DEPTH} - 1")
            if(DEPTH EQUAL 0)
                string(REGEX REPLACE "[ \t\r\n]+" " " PRESERVED
                    "${PRESERVED}")
                string(REGEX REPLACE "[ \t\r\n]+" " " CODE "${CODE}")
                string(STRIP "${PRESERVED}" PRESERVED)
                string(STRIP "${CODE}" CODE)
                set(${PRESERVED_OUTPUT} "${PRESERVED}" PARENT_SCOPE)
                set(${CODE_OUTPUT} "${CODE}" PARENT_SCOPE)
                return()
            endif()
        endif()
        if(BODY_STARTED)
            string(APPEND PRESERVED "${CHARACTER}")
            string(APPEND CODE "${CHARACTER}")
        endif()
    endforeach()

    if(STATE STREQUAL line_comment)
        set(STATE normal)
    endif()
    if(NOT STATE STREQUAL normal)
        message(FATAL_ERROR "Unterminated C++ lexical construct: ${STATE}")
    endif()
    if(EXTRACT_FUNCTION)
        if(NOT MARKER_FOUND)
            message(FATAL_ERROR
                "Unable to find C++ function marker: ${FUNCTION_MARKER}")
        endif()
        message(FATAL_ERROR
            "Unbalanced C++ function body: ${FUNCTION_MARKER}")
    endif()

    string(REGEX REPLACE "[ \t\r\n]+" " " PRESERVED "${PRESERVED}")
    string(REGEX REPLACE "[ \t\r\n]+" " " CODE "${CODE}")
    string(STRIP "${PRESERVED}" PRESERVED)
    string(STRIP "${CODE}" CODE)
    set(${PRESERVED_OUTPUT} "${PRESERVED}" PARENT_SCOPE)
    set(${CODE_OUTPUT} "${CODE}" PARENT_SCOPE)
endfunction()

function(normalize_cpp_source INPUT OUTPUT)
    _scan_cpp_source("${INPUT}" "" PRESERVED CODE)
    set(${OUTPUT} "${PRESERVED}" PARENT_SCOPE)
    if(ARGC GREATER 2)
        set(${ARGV2} "${CODE}" PARENT_SCOPE)
    endif()
endfunction()

function(extract_cpp_function_body SOURCE FUNCTION_MARKER OUTPUT)
    _scan_cpp_source("${SOURCE}" "${FUNCTION_MARKER}" PRESERVED CODE)
    set(${OUTPUT} "${PRESERVED}" PARENT_SCOPE)
    if(ARGC GREATER 3)
        set(${ARGV3} "${CODE}" PARENT_SCOPE)
    endif()
endfunction()

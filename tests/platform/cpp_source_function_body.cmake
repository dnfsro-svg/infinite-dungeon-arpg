cmake_minimum_required(VERSION 3.25)

function(normalize_cpp_source INPUT OUTPUT)
    string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" "" VALUE "${INPUT}")
    string(REGEX REPLACE "//[^\r\n]*" "" VALUE "${VALUE}")
    string(REGEX REPLACE "[ \t\r\n]+" " " VALUE "${VALUE}")
    string(STRIP "${VALUE}" VALUE)
    set(${OUTPUT} "${VALUE}" PARENT_SCOPE)
endfunction()

function(extract_cpp_function_body SOURCE FUNCTION_MARKER OUTPUT)
    string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" "" CODE "${SOURCE}")
    string(REGEX REPLACE "//[^\r\n]*" "" CODE "${CODE}")
    string(FIND "${CODE}" "${FUNCTION_MARKER}" MARKER_INDEX)
    if(MARKER_INDEX EQUAL -1)
        message(FATAL_ERROR
            "Unable to find C++ function marker: ${FUNCTION_MARKER}")
    endif()

    string(LENGTH "${CODE}" CODE_LENGTH)
    math(EXPR LAST_INDEX "${CODE_LENGTH} - 1")
    set(OPEN_FOUND FALSE)
    set(IN_STRING FALSE)
    set(ESCAPED FALSE)
    set(DEPTH 0)
    foreach(INDEX RANGE ${MARKER_INDEX} ${LAST_INDEX})
        string(SUBSTRING "${CODE}" ${INDEX} 1 CHARACTER)
        if(IN_STRING)
            if(ESCAPED)
                set(ESCAPED FALSE)
            elseif(CHARACTER STREQUAL "\\")
                set(ESCAPED TRUE)
            elseif(CHARACTER STREQUAL "\"")
                set(IN_STRING FALSE)
            endif()
            continue()
        endif()
        if(CHARACTER STREQUAL "\"")
            set(IN_STRING TRUE)
            continue()
        endif()
        if(CHARACTER STREQUAL "{")
            if(NOT OPEN_FOUND)
                set(OPEN_FOUND TRUE)
                set(DEPTH 1)
                math(EXPR BODY_START "${INDEX} + 1")
            else()
                math(EXPR DEPTH "${DEPTH} + 1")
            endif()
            continue()
        endif()
        if(OPEN_FOUND AND CHARACTER STREQUAL "}")
            math(EXPR DEPTH "${DEPTH} - 1")
            if(DEPTH EQUAL 0)
                math(EXPR BODY_LENGTH "${INDEX} - ${BODY_START}")
                string(SUBSTRING "${CODE}" ${BODY_START} ${BODY_LENGTH} BODY)
                normalize_cpp_source("${BODY}" NORMALIZED_BODY)
                set(${OUTPUT} "${NORMALIZED_BODY}" PARENT_SCOPE)
                return()
            endif()
        endif()
    endforeach()
    message(FATAL_ERROR
        "Unbalanced C++ function body: ${FUNCTION_MARKER}")
endfunction()

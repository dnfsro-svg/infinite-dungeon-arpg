+[[nodiscard]] std::size_t axis_slot_count(
+    float span, float minimum_step) noexcept {
+    std::size_t count = 1U;
+    while (count < kLabelCapacity
+            && minimum_step * static_cast<float>(count) <= span) {
+        ++count;
+    }
+    return count;

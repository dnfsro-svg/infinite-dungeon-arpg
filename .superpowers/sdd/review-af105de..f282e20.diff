+bool player_in_hole_range(
+    combat::Vec3 position,
+    combat::Vec3 center,
+    float radius) noexcept {
+    if (radius < 0.0F) {
+        return false;
+    }
+    const float x = position.x - center.x;
+    const float y = position.y - center.y;
+    return x * x + y * y <= radius * radius;
+}

+- [ ] **Step 4: 实现固定拒绝采样**
+
+头文件加入 optional。实现必须等价于：
+
+    std::optional<std::uint64_t>
+    DeterministicRng::next_bounded(std::uint64_t bound) noexcept {
+        if (bound == 0U) {
+            return std::nullopt;
+        }
+        const std::uint64_t threshold =
+            (std::uint64_t{0} - bound) % bound;
+        for (;;) {
+            const std::uint64_t value = next_u64();
+            if (value >= threshold) {
+                return value % bound;
+            }
+        }
+    }
+

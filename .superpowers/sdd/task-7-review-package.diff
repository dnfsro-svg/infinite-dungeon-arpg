+    arpg::test::set_pending_pickup_ordinal(wrong_ordinal, wrong);
+    wrong_ordinal.resolve_pending_save({
+        arpg::dungeon::SaveDisposition::committed,
+        wrong_pending.expected_generation,
+        wrong_pending.next_state,
+    });

+        INIT_WINDOW_INDEX)
+    string(FIND "${HOST_ENTRY_SOURCE}" "${RENDERER_STORAGE_MATCH}"
+        RENDERER_STORAGE_INDEX)
+    if(NOT VALIDATION_OWNER_INDEX LESS VALIDATION_NULL_INDEX

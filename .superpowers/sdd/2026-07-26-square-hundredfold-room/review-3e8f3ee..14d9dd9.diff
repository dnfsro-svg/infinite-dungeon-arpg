+        message(STATUS
+            "host ownership guard: owner='${VALIDATION_OWNER_MATCH}' null='${VALIDATION_NULL_MATCH}' flags='${INITIAL_FLAGS_MATCH}' window='${INIT_WINDOW_MATCH}' renderer='${RENDERER_STORAGE_MATCH}'")
+        set("${OUT_VALID}" FALSE PARENT_SCOPE)

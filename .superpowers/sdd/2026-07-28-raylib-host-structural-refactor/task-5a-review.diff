+    foreach(_label IN LISTS LABELS)
+        foreach(_kind IN ITEMS BEGIN END)
+            set(_token "TASK5A_${PREFIX}_${_label}_${_kind}_MARKER")
+            stage11d_count_raw_token("${_code}" "${_token}" _count)

+# Keep the new adversarial cases in this direct production guard.  Legacy
+# HOST_OVERRIDE fixtures retain their focused historical assertions without
+# repeatedly parsing these extra Stage17-only source variants.
+function(assert_stage17_lifecycle_memory_mutations HOST_SOURCE)
+    set(_request [=[std::optional<std::string> capture_path = stage17_capture_path(
+                config, *stage17_validation_state);]=])
+    set(_requested [=[const bool stage17_capture_requested = capture_path.has_value();]=])
+    set(_mark [=[mark_stage17_capture_complete(*stage17_validation_state);]=])
+
+    # Deleting the only completion mark is observable in the active source.
+    string(REPLACE "${_mark}" "mark_stage17_capture_complete_removed(*stage17_validation_state);"
+        _deleted_mark "${HOST_SOURCE}")
+    stage17_mask_cpp_conditionals("${_deleted_mark}" _deleted_mark_active)
+    string(FIND "${_deleted_mark_active}" "${_mark}" _deleted_mark_position)
+    if(NOT _deleted_mark_position EQUAL -1)
+        message(FATAL_ERROR "Stage17 lifecycle mutation self-check did not delete completion mark")
+    endif()
+
+    # Request moved after the first competing branch must invert the required
+    # direct-loop order.  This guards against priority regressions.
+    string(REPLACE "${_request}" "stage17_capture_path_removed(config, *stage17_validation_state);"
+        _moved_request "${HOST_SOURCE}")
+    string(REPLACE "if (!capture_path.has_value() && stage12_item_baseline_frame) {"
+        "if (!capture_path.has_value() && stage12_item_baseline_frame) {\n${_request}"
+        _moved_request "${_moved_request}")
+    stage17_mask_cpp_conditionals("${_moved_request}" _moved_request_active)
+    string(FIND "${_moved_request_active}" "stage17_capture_path(" _moved_request_position)
+    string(FIND "${_moved_request_active}"
+        "if (!capture_path.has_value() && stage12_item_baseline_frame) {"
+        _moved_competition_position)
+    if(NOT _moved_competition_position LESS _moved_request_position)
+        message(FATAL_ERROR "Stage17 lifecycle mutation self-check did not move request after competition")
+    endif()
+
+    # Any return between request and mark is a rejected early exit, even when
+    # nested evidence elsewhere could make a loose regex appear satisfied.
+    string(REPLACE "${_requested}" "${_requested}\n            return HostExitCode::success;"
+        _early_return "${HOST_SOURCE}")
+    stage17_mask_cpp_conditionals("${_early_return}" _early_return_active)
+    string(FIND "${_early_return_active}" "stage17_capture_path(" _early_request_position)
+    string(FIND "${_early_return_active}" "${_mark}" _early_mark_position)
+    math(EXPR _early_length "${_early_mark_position} - ${_early_request_position}")
+    string(SUBSTRING "${_early_return_active}" ${_early_request_position}
+        ${_early_length} _early_segment)
+    string(FIND "${_early_segment}" "return HostExitCode::success;" _early_return_position)
+    if(_early_return_position EQUAL -1)
+        message(FATAL_ERROR "Stage17 lifecycle mutation self-check did not expose early return")
+    endif()
+
+    # A valid-looking uncalled lambda/cross-scope decoy is deliberately deeper
+    # than the loop's direct bindings, so it cannot satisfy the real check.
+    string(REPLACE "const bool capture_succeeded ="
+        "const bool capture_succeeded_removed =" _lambda_mutation "${HOST_SOURCE}")
+    string(REPLACE "const bool capture_succeeded_removed ="
+        "const auto stage17_uncalled_capture_lambda = [&] {\n                const bool capture_succeeded ="
+        _lambda_mutation "${_lambda_mutation}")
+    string(REPLACE "present_frame_and_maybe_capture(capture_path.has_value()"
+        "present_frame_and_maybe_capture(capture_path.has_value()"
+        _lambda_mutation "${_lambda_mutation}")
+    stage17_mask_cpp_conditionals("${_lambda_mutation}" _lambda_active)
+    string(FIND "${_lambda_active}" "const bool capture_succeeded =" _lambda_position)
+    cpp_token_brace_depth("${_lambda_active}" ${_lambda_position} _lambda_depth)
+    if(_lambda_depth LESS 4)
+        message(FATAL_ERROR "Stage17 lifecycle mutation self-check did not create lambda cross-scope decoy")
+    endif()
+endfunction()

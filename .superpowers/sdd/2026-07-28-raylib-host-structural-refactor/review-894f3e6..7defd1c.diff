 # Shared source scanner for evidence guards. Non-code characters become spaces
-# while newlines and source length remain unchanged, so brace offsets stay valid.
+# while line endings and source length remain unchanged, so brace offsets stay valid.
+function(evidence_is_cpp_splice source index output)
+    string(ASCII 10 newline)
+    string(ASCII 13 carriage_return)
+    string(ASCII 92 backslash)
+    string(LENGTH "${source}" source_length)
+    if(index GREATER_EQUAL source_length)
+        set(${output} FALSE PARENT_SCOPE)
+        return()
+    endif()
+    string(SUBSTRING "${source}" ${index} 1 character)
+    if(NOT character STREQUAL "${backslash}")
+        set(${output} FALSE PARENT_SCOPE)
+        return()
+    endif()
+    math(EXPR next_index "${index} + 1")
+    if(next_index GREATER_EQUAL source_length)
+        set(${output} FALSE PARENT_SCOPE)
+        return()
+    endif()
+    string(SUBSTRING "${source}" ${next_index} 1 next_character)
+    if(next_character STREQUAL "${newline}")
+        set(${output} TRUE PARENT_SCOPE)
+        return()
+    endif()
+    math(EXPR after_next_index "${index} + 2")
+    if(next_character STREQUAL "${carriage_return}"
+            AND after_next_index LESS source_length)
+        string(SUBSTRING "${source}" ${after_next_index} 1 after_next_character)
+        if(after_next_character STREQUAL "${newline}")
+            set(${output} TRUE PARENT_SCOPE)
+            return()
+        endif()
+    endif()
+    set(${output} FALSE PARENT_SCOPE)
+endfunction()
+
+function(evidence_cpp_logical_next_character source start output_character output_found)
+    string(ASCII 10 newline)
+    string(ASCII 13 carriage_return)
+    string(LENGTH "${source}" source_length)
+    set(probe ${start})
+    while(probe LESS source_length)
+        evidence_is_cpp_splice("${source}" ${probe} is_splice)
+        if(is_splice)
+            math(EXPR newline_index "${probe} + 1")
+            string(SUBSTRING "${source}" ${newline_index} 1 splice_newline)
+            if(splice_newline STREQUAL "${carriage_return}")
+                math(EXPR probe "${probe} + 3")
+            else()
+                math(EXPR probe "${probe} + 2")
+            endif()
+        else()
+            string(SUBSTRING "${source}" ${probe} 1 logical_character)
+            set(${output_character} "${logical_character}" PARENT_SCOPE)
+            set(${output_found} TRUE PARENT_SCOPE)
+            return()
+        endif()
+    endwhile()
+    set(${output_character} "" PARENT_SCOPE)
+    set(${output_found} FALSE PARENT_SCOPE)
+endfunction()

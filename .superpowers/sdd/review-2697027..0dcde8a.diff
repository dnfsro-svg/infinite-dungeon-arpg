+    ARPG_REQUIRE(kinds[1] == CombatEventKind::hit);
+    ARPG_REQUIRE(kinds[2] == CombatEventKind::defeated);
+    ARPG_REQUIRE(kinds[3] == CombatEventKind::impact_summary);
+
+    tick_n(world, 3);
+    tick_n(world, 89);

+    ARPG_REQUIRE(null_destination.input_was_valid);
+    ARPG_REQUIRE(null_destination.truncated);
+    return {};
+}
+
+arpg::test::Failure format_repairs_partial_tail_and_remains_allocation_free()
+    noexcept {

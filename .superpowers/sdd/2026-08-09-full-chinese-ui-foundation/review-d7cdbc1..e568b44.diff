         return reject_partial_overlap(destination, capacity, source);
     }
 
     for (const char* cursor = source; *cursor != '\0';) {
         const DecodedCodePoint decoded = decode(cursor);
         const std::size_t output_length = decoded.kind == DecodeKind::valid
             ? decoded.length

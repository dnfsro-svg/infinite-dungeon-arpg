+struct PixelRoi final {
+    int x{};
+    int y{};
+    int width{};
+    int height{};
+
+    [[nodiscard]] bool valid() const noexcept {
+        return x >= 0 && y >= 0 && width > 0 && height > 0
+            && x + width <= 1280 && y + height <= 720;
+    }
+};

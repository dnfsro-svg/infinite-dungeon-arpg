+    const int after_first = world.snapshot().player.hp;
+    ARPG_REQUIRE(after_first == max_hp - 350);
+    ARPG_REQUIRE(world.snapshot().player.hurt_ticks == 12);
+    ARPG_REQUIRE(world.snapshot().player.invulnerability_ticks == 30);

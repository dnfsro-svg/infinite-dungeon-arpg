+    config.initial_facing = Facing::right;
+    config.wave.spawn_count = 1U;
+    config.wave.spawns[0] = MonsterSpawnSpec{
+        MonsterId::chaos_chaser, Vec3{1.0F, 0.0F, 0.0F}};
+    config.reset_player_health = true;

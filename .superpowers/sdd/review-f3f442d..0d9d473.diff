+        const HazardVisualMode mode = hazard_visual_mode(hazard);
+        if (mode == HazardVisualMode::hidden) {
+            continue;
+        }
+        const ScreenProjection projected = project_hazard_center(
+            hazard, width, height);
+        const float radius = std::max(9.0F, hazard.radius * 58.0F)
+            * projected.scale;

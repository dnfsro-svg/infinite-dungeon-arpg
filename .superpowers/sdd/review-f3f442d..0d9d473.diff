+    arpg::test::CombatWorldTestAccess::apply_damage(
+        world, 350, Vec3{1.0F, 0.0F, 0.0F}, FeedbackLevel::light);
+    ARPG_REQUIRE(world.snapshot().player.hp == after_first);

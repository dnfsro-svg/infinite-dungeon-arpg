+constexpr std::uint8_t slots(std::initializer_list<ItemSlot> values) noexcept {
+    std::uint8_t result = 0U;
+    for (const ItemSlot slot : values)
+        result = static_cast<std::uint8_t>(result | slot_bit(slot));
+    return result;
+}

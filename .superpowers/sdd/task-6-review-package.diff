+    DungeonRunState state = arpg::dungeon::make_initial_run_state(
+        0x81818181ULL, DungeonRules{}).state;
+    state.item_ownership.items.assign(items.begin(), items.end());
+    state.item_ownership.next_item_sequence = 9U;
+    return state;
+}

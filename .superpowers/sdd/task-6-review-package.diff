+ItemInstance level_16_magic_weapon(std::uint64_t id) noexcept {
+    ItemInstance item = normal_item(id, 1U, 16U);
+    item.rarity = ItemRarity::magic;
+    item.required_level = 16U;
+    item.affixes[0] = {3U, 7U, 0xFFU};
+    item.affix_count = 1U;

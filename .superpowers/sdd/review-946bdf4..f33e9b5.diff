+    ARPG_REQUIRE(reinforced_base_value(1, 1000U) == maximum);
+    ARPG_REQUIRE(reinforced_base_value(-1, 1000U) == minimum);
+    ARPG_REQUIRE(reinforced_base_value(0, 1000U) == 0);

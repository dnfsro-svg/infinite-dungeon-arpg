+            DrawCircleLines(static_cast<int>(center.x), static_cast<int>(center.y),
+                radius * 1.55F, Fade(color, 0.78F));
+        }
+        DrawCircleV(center, radius, color);
+        DrawCircleLines(static_cast<int>(center.x), static_cast<int>(center.y),
+            radius, RAYWHITE);
+    }
+}

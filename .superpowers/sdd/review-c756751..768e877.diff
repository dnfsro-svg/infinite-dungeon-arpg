+PlayerCombatBuild build_for_max_hp(int maximum) noexcept {
+    PlayerCombatBuild build{};
+    build.values.max_health = static_cast<std::int64_t>(maximum - 1000)
+        * arpg::modifiers::kFixedOne;
+    return build;
+}

+    ARPG_REQUIRE(unbiased.fault == DungeonFault::none);
+    ARPG_REQUIRE(biased.fault == DungeonFault::none);
+    ARPG_REQUIRE(preview_abyss_doors(unbiased.room)
+        == preview_abyss_doors(biased.room));
     return {};
 }
 

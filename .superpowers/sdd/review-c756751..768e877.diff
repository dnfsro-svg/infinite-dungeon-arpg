+std::size_t environment_hazard_count(
+    const arpg::combat::CombatSnapshot& state) noexcept {
+    std::size_t count = 0U;
+    for (const auto& hazard : state.hazards) {
+        if (hazard.active
+                && hazard.source
+                    == arpg::combat::HazardSource::abyss_environment) {
+            ++count;
+        }
+    }
+    return count;
+}

+        state.abyss.rule = selection->rule;
+        state.abyss.rules_version = selection->rules_version;
+        state.abyss.reward_total = arpg::abyss::reward_profile_for(
+            wanted, 1U).item_count;
+        return state;
+    }
+    return {};

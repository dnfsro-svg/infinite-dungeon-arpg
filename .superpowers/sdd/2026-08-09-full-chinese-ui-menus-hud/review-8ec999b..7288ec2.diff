                 continue()
             endif()
             set("${OUT_ALLOWED}" FALSE PARENT_SCOPE)
             set("${OUT_BAD_LINE}" "${_arpg_line}" PARENT_SCOPE)
             return()
         endif()
     endforeach()
     set("${OUT_ALLOWED}" TRUE PARENT_SCOPE)
     set("${OUT_BAD_LINE}" "" PARENT_SCOPE)
 endfunction()

diff --git a/tests/platform/task6_recovery_screen_source_self_test.cmake b/tests/platform/task6_recovery_screen_source_self_test.cmake
new file mode 100644
index 0000000..ec356fd
--- /dev/null
+++ b/tests/platform/task6_recovery_screen_source_self_test.cmake
@@ -0,0 +1,55 @@
+cmake_minimum_required(VERSION 3.25)
+
+if(NOT DEFINED SOURCE_ROOT OR NOT DEFINED MUTATION_ROOT)
+    message(FATAL_ERROR "SOURCE_ROOT and MUTATION_ROOT are required")
+endif()
+
+set(guard "${SOURCE_ROOT}/tests/platform/task6_recovery_screen_source_test.cmake")
+set(host "${SOURCE_ROOT}/src/platform/raylib/raylib_host.cpp")
+file(REMOVE_RECURSE "${MUTATION_ROOT}")
+file(MAKE_DIRECTORY "${MUTATION_ROOT}")
+
+execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_ROOT=${SOURCE_ROOT}"
+    -P "${guard}" RESULT_VARIABLE pristine_result)
+if(NOT pristine_result EQUAL 0)
+    message(FATAL_ERROR "Task 6 recovery source guard rejected pristine source")
+endif()
+
+file(READ "${host}" source)
+function(expect_rejected label mutated)
+    set(path "${MUTATION_ROOT}/${label}.cpp")
+    file(WRITE "${path}" "${mutated}")
+    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_ROOT=${SOURCE_ROOT}"
+        "-DHOST_SOURCE_OVERRIDE=${path}" -P "${guard}"
+        RESULT_VARIABLE result)
+    if(result EQUAL 0)
+        message(FATAL_ERROR "Task 6 recovery source guard accepted mutation: ${label}")
+    endif()
+endfunction()
+
+string(REPLACE
+    "draw_recovery_screen(shared_ui_font.font(), runtime.render_status());"
+    "draw_recovery_screen(Font{}, runtime.render_status());"
+    unshared_font "${source}")
+if(unshared_font STREQUAL source)
+    message(FATAL_ERROR "Task 6 shared-font mutation anchor is missing")
+endif()
+expect_rejected("unshared-font" "${unshared_font}")
+
+string(REPLACE
+    "draw_recovery_screen(shared_ui_font.font(), runtime.render_status());"
+    "static_cast<void>(present_frame_and_maybe_capture(nullptr));\n                draw_recovery_screen(shared_ui_font.font(), runtime.render_status());"
+    present_before_draw "${source}")
+if(present_before_draw STREQUAL source)
+    message(FATAL_ERROR "Task 6 present-order mutation anchor is missing")
+endif()
+expect_rejected("present-before-draw" "${present_before_draw}")
+
+string(REPLACE "draw_crisp_ui_text(font, text"
+    "DrawTextEx(font, text" default_text "${source}")
+if(default_text STREQUAL source)
+    message(FATAL_ERROR "Task 6 CJK draw mutation anchor is missing")
+endif()
+expect_rejected("default-text" "${default_text}")
+
+message(STATUS "Task 6 recovery source guard self-test rejected all mutations")
diff --git a/tests/platform/task6_recovery_screen_source_test.cmake b/tests/platform/task6_recovery_screen_source_test.cmake
new file mode 100644
index 0000000..edf7924
--- /dev/null
+++ b/tests/platform/task6_recovery_screen_source_test.cmake
@@ -0,0 +1,61 @@
+cmake_minimum_required(VERSION 3.25)
+
+if(NOT DEFINED SOURCE_ROOT)
+    message(FATAL_ERROR "SOURCE_ROOT is required")
+endif()
+
+set(host_source "${SOURCE_ROOT}/src/platform/raylib/raylib_host.cpp")
+if(DEFINED HOST_SOURCE_OVERRIDE)
+    set(host_source "${HOST_SOURCE_OVERRIDE}")
+endif()
+if(NOT EXISTS "${host_source}")
+    message(FATAL_ERROR "recovery screen host source is missing: ${host_source}")
+endif()
+
+include("${CMAKE_CURRENT_LIST_DIR}/cpp_source_function_body.cmake")
+file(READ "${host_source}" host_text)
+extract_cpp_function_body("${host_text}" "void draw_recovery_screen("
+    recovery_draw_body recovery_draw_code)
+
+foreach(required IN ITEMS
+        "const RecoveryScreenView view = ::arpg::platform::make_recovery_screen_view(status,"
+        "DrawRectangleRounded(view.panel"
+        "draw_crisp_ui_text(font, text")
+    string(FIND "${recovery_draw_body}" "${required}" found)
+    if(found EQUAL -1)
+        message(FATAL_ERROR "Task 6 recovery draw seam is missing: ${required}")
+    endif()
+endforeach()
+foreach(forbidden IN ITEMS "DrawText" "TextFormat" "GetFontDefault" "LoadFont")
+    string(FIND "${recovery_draw_code}" "${forbidden}" found)
+    if(NOT found EQUAL -1)
+        message(FATAL_ERROR "Task 6 recovery draw has a forbidden text/font path: ${forbidden}")
+    endif()
+endforeach()
+
+set(recovery_branch_marker
+    "if (runtime.state() == DungeonRuntimeState::recovery_required)")
+set(recovery_observe_marker
+    "renderer.observe_presented_hud_frame(HudPresentedFrame::recovery,")
+set(recovery_draw_marker
+    "draw_recovery_screen(shared_ui_font.font(), runtime.render_status());")
+set(recovery_present_marker
+    "static_cast<void>(present_frame_and_maybe_capture(")
+string(FIND "${host_text}" "${recovery_branch_marker}" recovery_branch_start)
+if(recovery_branch_start EQUAL -1)
+    message(FATAL_ERROR "Task 6 recovery branch is missing")
+endif()
+string(SUBSTRING "${host_text}" ${recovery_branch_start} -1 recovery_branch)
+foreach(marker_name IN ITEMS recovery_observe_marker recovery_draw_marker recovery_present_marker)
+    string(FIND "${recovery_branch}" "${${marker_name}}" ${marker_name}_index)
+    if(${marker_name}_index EQUAL -1)
+        message(FATAL_ERROR "Task 6 recovery branch is missing: ${${marker_name}}")
+    endif()
+endforeach()
+if(NOT recovery_observe_marker_index LESS recovery_draw_marker_index
+        OR NOT recovery_draw_marker_index LESS recovery_present_marker_index)
+    message(FATAL_ERROR
+        "Task 6 recovery presentation must observe, draw with SharedUiFont, then present/capture")
+endif()
+
+message(STATUS "Task 6 recovery source guard accepted")

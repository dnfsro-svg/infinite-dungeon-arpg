+cmake_minimum_required(VERSION 3.25)
+
+foreach(REQUIRED_INPUT IN ITEMS HUD_RENDERER_SOURCE ACTIVE_SKILL_RENDERER_SOURCE
+        GUARD_SCRIPT MUTATION_ROOT)

 function(require_token TEXT TOKEN MESSAGE_TEXT)
     string(FIND "${TEXT}" "${TOKEN}" _found)
     if(_found EQUAL -1)
         message(FATAL_ERROR "${MESSAGE_TEXT}: ${TOKEN}")
     endif()
 endfunction()
 

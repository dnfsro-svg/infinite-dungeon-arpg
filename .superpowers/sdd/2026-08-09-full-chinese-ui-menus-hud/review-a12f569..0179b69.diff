 template <typename Id, std::size_t Count>
 const char* value_or_unknown(const std::array<const char*, Count>& values,
     Id id) noexcept {
     const std::size_t index = static_cast<std::size_t>(id);
     return index < values.size() ? values[index] : kUnknown;
 }
 

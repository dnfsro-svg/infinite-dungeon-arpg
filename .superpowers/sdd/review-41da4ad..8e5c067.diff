+
+    constexpr std::array<checkpoint::ExitDirection, 4> directions{{
+        checkpoint::ExitDirection::up,
+        checkpoint::ExitDirection::down,
+        checkpoint::ExitDirection::left,
+        checkpoint::ExitDirection::right,
+    }};

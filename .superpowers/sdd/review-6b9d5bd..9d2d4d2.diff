+            snapshot.passive_tree.allocated_bits,
+            snapshot.commit_generation,
+            snapshot.combat->player.hp,
+            snapshot.combat->player.barrier,
+        };
+        if (!drive_exit(session, kRoute[room_index % kRoute.size()], summary, true)) {
+            return false;
+        }
+    }
+    return true;
+}

+        "${LABEL} poison includes")
+    string(REGEX MATCH
+        "${POISON_INCLUDE_LINE_PATTERN}"
+        POISON_INCLUDE_LINE
+        "${SOURCE}")
+    string(FIND "${SOURCE}" "${POISON_INCLUDE_LINE}" INCLUDE_INDEX)

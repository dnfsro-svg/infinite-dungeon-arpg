+std::size_t collect_affixes(
+    std::array<const AffixDefinition*, 24>& definitions) noexcept {
+    std::size_t count = 0U;
+    for (std::uint16_t id = 1U; id <= 12U; ++id)
+        definitions[count++] = affix_definition(id);
+    for (std::uint16_t id = 101U; id <= 112U; ++id)
+        definitions[count++] = affix_definition(id);
+    return count;
+}

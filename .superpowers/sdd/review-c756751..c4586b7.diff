+        for (std::size_t affix = 0U; affix < a.affixes.size(); ++affix) {
+            if (a.affixes[affix].affix_id != b.affixes[affix].affix_id
+                    || a.affixes[affix].tier != b.affixes[affix].tier
+                    || a.affixes[affix].variant

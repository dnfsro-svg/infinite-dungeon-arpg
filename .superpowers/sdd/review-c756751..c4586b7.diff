+int main(int argc, char** argv) {
+    if (argc == 5 && argv[1] != nullptr
+            && std::string{argv[1]} == "--scenario") {
+        return run_host_child(std::filesystem::absolute(argv[3]), argv[2],
+            std::stoull(argv[4])) ? 0 : 1;

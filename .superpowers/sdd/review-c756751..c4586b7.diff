+function(strip_cpp_noncode SOURCE OUT_VARIABLE)
+    set(CODE "${SOURCE}")
+    string(REGEX REPLACE "/\\*([^*]|\\*[^/])*\\*/" "" CODE "${CODE}")
+    string(REGEX REPLACE "//[^\r\n]*" "" CODE "${CODE}")
+    string(REGEX REPLACE "\"[^\"]*\"" "\"\"" CODE "${CODE}")
+    set("${OUT_VARIABLE}" "${CODE}" PARENT_SCOPE)
+endfunction()

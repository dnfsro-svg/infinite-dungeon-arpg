+constexpr std::uint32_t update_fixture_crc(std::uint32_t state,
+    const std::uint8_t* bytes, std::size_t size) noexcept {
+    std::uint32_t crc = state ^ 0xFFFFFFFFU;
+    for (std::size_t index = 0U; index < size; ++index) {

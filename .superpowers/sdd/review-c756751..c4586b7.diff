+bool ascii_only(const char* text) noexcept {
+    for (const auto* byte = reinterpret_cast<const unsigned char*>(text);
+         *byte != 0U; ++byte) {
+        if (*byte > 0x7FU) return false;
+    }
+    return true;
+}

+std::size_t utf8_glyph_count(const char* text) noexcept {
+    std::size_t count = 0U;
+    for (const auto* byte = reinterpret_cast<const unsigned char*>(text);
+         *byte != 0U; ++byte) {
+        if ((*byte & 0xC0U) != 0x80U) ++count;
+    }
+    return count;
+}

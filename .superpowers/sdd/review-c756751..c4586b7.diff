+void HudRenderer::shutdown() noexcept {
+    const HudFontSelectionPlan selection =
+        make_hud_font_selection_plan(font_ready_);
+    if (selection.owns_loaded_font && IsWindowReady()) UnloadFont(font_);
+    font_ = {};
+    font_ready_ = false;
+}

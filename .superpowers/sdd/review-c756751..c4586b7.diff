+    ARPG_REQUIRE(empty_plan.op_count == empty_view.row_count + 4U);
+    ARPG_REQUIRE(empty_plan.ops[empty_plan.op_count - 1U].kind
+        == platform::PauseMenuRenderOpKind::footer);
+    return {};
+}

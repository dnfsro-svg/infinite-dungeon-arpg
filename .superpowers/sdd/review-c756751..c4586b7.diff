+        execute_process(
+            COMMAND "${CMAKE_COMMAND}"
+                "-DSOURCE_ROOT=${SOURCE_ROOT}"
+                "-DSTAGE11_GUARD_MUTATION_MODE=1"
+                "-DSTAGE11_GUARD_MUTATION_KIND=${KIND}"
+                "-DSTAGE11_GUARD_MUTATION_FILE=${_fixture}"

+void write_stage17_loadout(std::ostream& stream,
+    const skills::SkillLoadoutState& loadout) {
+    for (std::size_t index = 0U; index < loadout.slots.size(); ++index) {
+        if (index != 0U) stream << ',';
+        stream << stage17_skill_name(loadout.slots[index].active);

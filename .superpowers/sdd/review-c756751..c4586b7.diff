+    [=[#/**/include/**/<raylib.h>]=])
+arpg_expect_pause_boundary(
+    "continued directive" TRUE [=[#inc\
+lude <raylib.h>]=])
+arpg_expect_pause_boundary(
+    "continued header" TRUE [=[#include \
+<raylib.h>]=])
+string(ASCII 13 ARPG_PAUSE_BOUNDARY_CR)
+set(ARPG_PAUSE_BOUNDARY_CRLF_INCLUDE
+    "#include \\${ARPG_PAUSE_BOUNDARY_CR}\n<raylib.h>")

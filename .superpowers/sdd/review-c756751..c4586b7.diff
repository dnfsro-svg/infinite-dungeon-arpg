+string(REPLACE "${_fixture_body}" "" _death_stress_outside_fixture
+    "${_death_stress_text}")
+if(_death_stress_outside_fixture MATCHES "stable_state_[^A-Za-z0-9]")
+    message(FATAL_ERROR
+        "Death stress stable-state private access must stay inside its fixture")

diff --git a/tests/dungeon/stage11_evidence_bad_injection.txt b/tests/dungeon/stage11_evidence_bad_injection.txt
new file mode 100644
index 0000000..51076b7
--- /dev/null
+++ b/tests/dungeon/stage11_evidence_bad_injection.txt

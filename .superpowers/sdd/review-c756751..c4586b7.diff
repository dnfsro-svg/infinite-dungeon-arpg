+        (std::numeric_limits<std::uint64_t>::max)();
+    maximum.combat->player.hp = INT_MAX;
+    maximum.combat->player.max_hp = INT_MAX;
+    maximum.combat->player.barrier = INT_MAX;
+    maximum.combat->player.max_barrier = INT_MAX;

 bool same_ownership(const items::ItemOwnershipState& lhs,
     const items::ItemOwnershipState& rhs) noexcept {
     if (lhs.items.size() != rhs.items.size()
         || lhs.equipment.equipped_ids != rhs.equipment.equipped_ids

+    ARPG_REQUIRE(arpg::dungeon::material_drop_chance_bp(17U) == 2500U);
+    ARPG_REQUIRE(arpg::dungeon::material_drop_chance_bp(26U) == 3400U);
+    ARPG_REQUIRE(arpg::dungeon::material_drop_chance_bp(27U) == 3500U);

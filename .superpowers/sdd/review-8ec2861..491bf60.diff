+std::uint64_t selection_root(std::uint64_t room_seed) noexcept {
+    auto version = arpg::core::DeterministicRng::derive_stream(
+        room_seed, kRulesVersionDomain ^ arpg::abyss::kAbyssRulesVersion);
+    return version.next_u64();
+}

+AbyssDanger expected_danger(
+    std::uint64_t roll,
+    std::uint8_t low,
+    std::uint8_t medium) noexcept {
+    if (roll < low) return AbyssDanger::low;
+    if (roll < static_cast<std::uint64_t>(low) + medium)
+        return AbyssDanger::medium;
+    return AbyssDanger::high;
+}

+        if (!writer.u8(static_cast<std::uint8_t>(ground.tag))
+                || !writer.u16(ground.ordinal) || !writer.u8(ground.source)
+                || !write_vec(writer, ground.position)
+                || !writer.u8(static_cast<std::uint8_t>(ground.material))) {
+            return false;
+        }
+    }
+    return true;
+}

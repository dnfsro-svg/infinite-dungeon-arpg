+    if (!read_room_combat(reader, value.combat)
+            || !reader.u16(value.equipment_ground_count)
+            || value.equipment_ground_count > value.equipment_ground.size()) {
+        return false;
+    }
+    for (std::uint16_t index = 0U; index < value.equipment_ground_count;

+[[nodiscard]] std::uint64_t file_time_value(FILETIME value) noexcept {
+    ULARGE_INTEGER converted{};
+    converted.LowPart = value.dwLowDateTime;
+    converted.HighPart = value.dwHighDateTime;
+    return converted.QuadPart;
+}

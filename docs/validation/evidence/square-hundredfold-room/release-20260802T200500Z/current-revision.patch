+    std::uint64_t encode_ns{};
+    std::uint64_t durable_write_ns{};
+    std::uint64_t file_readback_ns{};
+    std::size_t encoded_bytes{};
+    std::uint16_t write_operations{};
+    std::uint16_t readback_operations{};

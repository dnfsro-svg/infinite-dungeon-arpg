+        "(^|[^A-Za-z0-9_])(const${WS1})?HostValidationStates${WS1}[A-Za-z_][A-Za-z0-9_]*${WS}(\\{|\\(|;|=)"
+        AUTOMATIC_VALIDATION_DECLARATIONS "${SOURCE}")

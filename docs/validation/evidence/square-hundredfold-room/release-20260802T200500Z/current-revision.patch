+function(expect_guard_rejection name host expected)
+    execute_process(
+        COMMAND "${CMAKE_COMMAND}"
+            -DFIXTURE_SOURCE=${VALID_FIXTURE}
+            -DVALIDATION_GAME_SOURCE=${VALIDATION_GAME_SOURCE}
+            -DFORMAL_SOURCE=${FORMAL_SOURCE}

+[[nodiscard]] bool read_thread_cycles(std::uint64_t& value) noexcept {
+    ULONG64 cycles{};
+    if (!QueryThreadCycleTime(GetCurrentThread(), &cycles)) return false;
+    value = static_cast<std::uint64_t>(cycles);
+    return true;
+}

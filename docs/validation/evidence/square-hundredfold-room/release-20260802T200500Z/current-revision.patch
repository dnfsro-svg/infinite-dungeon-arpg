+    runtime.hp = 73;
+    runtime.max_hp = 211;
+    runtime.break_value = 19;
+    runtime.max_break = 67;
+    runtime.shield = 31;
+    runtime.max_shield = 83;
+    runtime.shield_ticks = 43U;

-    case Stage17ValidationStep::approach_draw:
-        if (submitted.skills[0] == combat::SkillCastResult::accepted) {
-            state.draw_accepted = true;
-            state.public_input_path = true;
-            state.step = Stage17ValidationStep::draw_active;

+    return finite(value) && value.x >= room_bounds::min_x
+        && value.x <= room_bounds::max_x && value.y >= room_bounds::min_y
+        && value.y <= room_bounds::max_y && value.z >= 0.0F
+        && value.z <= 32.0F;

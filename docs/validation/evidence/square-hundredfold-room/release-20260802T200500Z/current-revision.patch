+    string(SUBSTRING "${ACTIVE_SOURCE}" ${FUNCTION_BEGIN} -1 FUNCTION_TAIL)
+    string(FIND "${FUNCTION_TAIL}" "{" FUNCTION_OPEN_RELATIVE)
+    string(FIND "${FUNCTION_TAIL}" ";" DECLARATION_END_RELATIVE)

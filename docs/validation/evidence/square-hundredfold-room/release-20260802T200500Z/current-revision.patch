+    {0.0F, combat::room_bounds::min_y, 0.0F},
+    {0.0F, combat::room_bounds::max_y, 0.0F},
+    {combat::room_bounds::min_x, 0.0F, 0.0F},
+    {combat::room_bounds::max_x, 0.0F, 0.0F},
+}};

+#include "dungeon/room_affix.hpp"
+#endif
+
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#define CloseWindow CloseWindowWin32
+#define ShowCursor ShowCursorWin32
+#include <windows.h>
+#undef ShowCursor
+#undef CloseWindow
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>

-void inject_stage11b_open_settings(PhysicalKeySnapshot& snapshot,
-    std::uint32_t frame) noexcept {
-    if (frame == 1U) snapshot.escape = true;
-    if (frame == 2U) inject_stage11b_pressed(snapshot, settings::StableKey::arrow_down);

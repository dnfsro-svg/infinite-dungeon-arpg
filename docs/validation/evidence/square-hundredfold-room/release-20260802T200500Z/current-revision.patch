+        foreach(_brace_index RANGE 0 ${_brace_last})
+            string(SUBSTRING "${_braces}" ${_brace_index} 1 _brace)
+            if(_brace STREQUAL "{")
+                math(EXPR _depth "${_depth} + 1")
+            else()

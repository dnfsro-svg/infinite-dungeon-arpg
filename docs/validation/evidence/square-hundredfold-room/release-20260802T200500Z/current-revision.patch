+    string(REGEX MATCHALL
+        "(^|[^A-Za-z0-9_])DungeonSnapshot${WS}(\\{|\\()"
+        DIRECT_SNAPSHOT_CONSTRUCTIONS "${SOURCE}")
+    list(LENGTH DIRECT_SNAPSHOT_CONSTRUCTIONS
+        DIRECT_SNAPSHOT_CONSTRUCTION_COUNT)

-        break;
-    case Stage17ValidationStep::approach_storm:
-        if (submitted.skills[1] == combat::SkillCastResult::accepted) {
-            state.storm_accepted = true;
-            state.public_input_path = true;
-            state.step = Stage17ValidationStep::storm_active;
-        }
-        break;
